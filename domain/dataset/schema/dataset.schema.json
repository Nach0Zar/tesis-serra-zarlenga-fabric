{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pfi-snt:synthetic-dataset:schema:2.0.0",
  "title": "Dataset sintético CLI-5",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "units"],
  "properties": {
    "$schema": {
      "const": "urn:pfi-snt:synthetic-dataset:schema:2.0.0"
    },
    "schemaVersion": {
      "const": "2.0.0"
    },
    "units": {
      "type": "array",
      "minItems": 50000,
      "items": {
        "$ref": "#/$defs/unitScenario"
      }
    }
  },
  "$defs": {
    "mspId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9.-]+MSP$"
    },
    "custodialId": {
      "type": "string",
      "pattern": "^(GLN|CUFE):[0-9]{13}$"
    },
    "unitRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gtin", "numeroSerie"],
      "properties": {
        "gtin": {
          "type": "string",
          "pattern": "^[0-9]{14}$"
        },
        "numeroSerie": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^[A-Z0-9-]+$",
          "not": {
            "pattern": "^779.{17}$"
          }
        }
      }
    },
    "registerRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gtin", "numeroSerie", "lote", "fechaVencimiento"],
      "properties": {
        "gtin": {
          "type": "string",
          "pattern": "^[0-9]{14}$"
        },
        "numeroSerie": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^[A-Z0-9-]+$",
          "not": {
            "pattern": "^779.{17}$"
          }
        },
        "lote": {
          "type": "string",
          "minLength": 1
        },
        "fechaVencimiento": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    },
    "unitEventRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gtin", "numeroSerie", "motivo"],
      "properties": {
        "gtin": {
          "type": "string",
          "pattern": "^[0-9]{14}$"
        },
        "numeroSerie": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^[A-Z0-9-]+$",
          "not": {
            "pattern": "^779.{17}$"
          }
        },
        "motivo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "destinationPrivateData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["destino"],
      "properties": {
        "destino": {
          "$ref": "#/$defs/custodialId"
        }
      }
    },
    "commercialPrivateData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numeroRemito", "numeroFactura", "cantidad"],
      "properties": {
        "numeroRemito": {
          "type": "string",
          "minLength": 1
        },
        "numeroFactura": {
          "type": "string",
          "minLength": 1
        },
        "cantidad": {
          "const": 1
        }
      }
    },
    "dispatchPrivateData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["destinatario", "commercial"],
      "properties": {
        "destinatario": {
          "$ref": "#/$defs/destinationPrivateData"
        },
        "commercial": {
          "$ref": "#/$defs/commercialPrivateData"
        }
      }
    },
    "registerInvocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "invokerMspId", "request"],
      "properties": {
        "operation": {
          "const": "RegisterUnit"
        },
        "invokerMspId": {
          "$ref": "#/$defs/mspId"
        },
        "request": {
          "$ref": "#/$defs/registerRequest"
        }
      }
    },
    "dispatchPreparation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "invokerMspId",
        "request",
        "privateData",
        "ruleId",
        "matrixSchemaVersion"
      ],
      "properties": {
        "operation": {
          "const": "DispatchTransfer"
        },
        "invokerMspId": {
          "$ref": "#/$defs/mspId"
        },
        "request": {
          "$ref": "#/$defs/unitRef"
        },
        "privateData": {
          "$ref": "#/$defs/dispatchPrivateData"
        },
        "ruleId": {
          "type": "string",
          "minLength": 1
        },
        "matrixSchemaVersion": {
          "type": "string",
          "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$"
        }
      }
    },
    "receiveInvocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "invokerMspId", "request"],
      "properties": {
        "operation": {
          "const": "ReceiveTransfer"
        },
        "invokerMspId": {
          "$ref": "#/$defs/mspId"
        },
        "request": {
          "$ref": "#/$defs/unitRef"
        }
      }
    },
    "stateEventInvocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "invokerMspId",
        "request",
        "transitionId",
        "stateMachineVersion"
      ],
      "properties": {
        "operation": {
          "enum": [
            "Quarantine",
            "ReportExpired",
            "ReportDamaged",
            "WithdrawFromMarket",
            "ProhibitProduct",
            "ReturnProduct"
          ]
        },
        "invokerMspId": {
          "$ref": "#/$defs/mspId"
        },
        "request": {
          "$ref": "#/$defs/unitEventRequest"
        },
        "transitionId": {
          "type": "string",
          "pattern": "^T[0-9]{2}_[A-Z0-9_]+$"
        },
        "stateMachineVersion": {
          "type": "string",
          "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$"
        }
      }
    },
    "preparationStep": {
      "oneOf": [
        {"$ref": "#/$defs/registerInvocation"},
        {"$ref": "#/$defs/dispatchPreparation"},
        {"$ref": "#/$defs/receiveInvocation"},
        {"$ref": "#/$defs/stateEventInvocation"}
      ]
    },
    "successInvocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "invokerMspId", "request"],
      "properties": {
        "operation": {
          "const": "Dispense"
        },
        "invokerMspId": {
          "$ref": "#/$defs/mspId"
        },
        "request": {
          "$ref": "#/$defs/unitRef"
        }
      }
    },
    "transferDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reason", "matrixSchemaVersion"],
      "properties": {
        "kind": {
          "enum": ["EXPLICIT_PROHIBITION", "DEFAULT_DENY"]
        },
        "ruleId": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "matrixSchemaVersion": {
          "type": "string",
          "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {"const": "EXPLICIT_PROHIBITION"}
            }
          },
          "then": {
            "required": ["ruleId"]
          },
          "else": {
            "not": {
              "required": ["ruleId"]
            }
          }
        }
      ]
    },
    "unauthorizedTransferRejection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "operation",
        "invokerMspId",
        "request",
        "privateData",
        "expectedErrorCode",
        "transferDecision"
      ],
      "properties": {
        "category": {"const": "UNAUTHORIZED_TRANSFER"},
        "operation": {"const": "DispatchTransfer"},
        "invokerMspId": {"$ref": "#/$defs/mspId"},
        "request": {"$ref": "#/$defs/unitRef"},
        "privateData": {"$ref": "#/$defs/dispatchPrivateData"},
        "expectedErrorCode": {"const": "TRANSFER_NOT_AUTHORIZED"},
        "transferDecision": {"$ref": "#/$defs/transferDecision"}
      }
    },
    "duplicateIdentityRejection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "operation",
        "invokerMspId",
        "request",
        "expectedErrorCode"
      ],
      "properties": {
        "category": {"const": "DUPLICATE_IDENTITY"},
        "operation": {"const": "RegisterUnit"},
        "invokerMspId": {"$ref": "#/$defs/mspId"},
        "request": {"$ref": "#/$defs/registerRequest"},
        "expectedErrorCode": {"const": "UNIT_ALREADY_EXISTS"}
      }
    },
    "blockingDispatchRejection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "operation",
        "invokerMspId",
        "request",
        "privateData",
        "expectedErrorCode",
        "blockingState",
        "stateMachineVersion"
      ],
      "properties": {
        "category": {"const": "BLOCKING_STATE"},
        "operation": {"const": "DispatchTransfer"},
        "invokerMspId": {"$ref": "#/$defs/mspId"},
        "request": {"$ref": "#/$defs/unitRef"},
        "privateData": {"$ref": "#/$defs/dispatchPrivateData"},
        "expectedErrorCode": {"const": "INVALID_STATE_TRANSITION"},
        "blockingState": {"type": "string", "minLength": 1},
        "stateMachineVersion": {
          "type": "string",
          "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$"
        }
      }
    },
    "blockingDispenseRejection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "operation",
        "invokerMspId",
        "request",
        "expectedErrorCode",
        "blockingState",
        "stateMachineVersion"
      ],
      "properties": {
        "category": {"const": "BLOCKING_STATE"},
        "operation": {"const": "Dispense"},
        "invokerMspId": {"$ref": "#/$defs/mspId"},
        "request": {"$ref": "#/$defs/unitRef"},
        "expectedErrorCode": {"const": "INVALID_STATE_TRANSITION"},
        "blockingState": {"type": "string", "minLength": 1},
        "stateMachineVersion": {
          "type": "string",
          "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$"
        }
      }
    },
    "expectedRejection": {
      "oneOf": [
        {"$ref": "#/$defs/unauthorizedTransferRejection"},
        {"$ref": "#/$defs/duplicateIdentityRejection"},
        {"$ref": "#/$defs/blockingDispatchRejection"},
        {"$ref": "#/$defs/blockingDispenseRejection"}
      ]
    },
    "unitScenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "initialState", "initialCustodian", "preparation"],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "initialState": {
          "const": "EN_LABORATORIO"
        },
        "initialCustodian": {
          "$ref": "#/$defs/custodialId"
        },
        "preparation": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/preparationStep"
          }
        },
        "expectedSuccess": {
          "$ref": "#/$defs/successInvocation"
        },
        "expectedRejection": {
          "$ref": "#/$defs/expectedRejection"
        }
      },
      "oneOf": [
        {
          "required": ["expectedSuccess"],
          "not": {"required": ["expectedRejection"]}
        },
        {
          "required": ["expectedRejection"],
          "not": {"required": ["expectedSuccess"]}
        }
      ]
    }
  }
}
