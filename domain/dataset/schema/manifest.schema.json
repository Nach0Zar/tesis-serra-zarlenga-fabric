{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pfi-snt:synthetic-dataset-manifest:schema:2.0.0",
  "title": "Manifiesto del dataset sintético CLI-5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "generator",
    "seed",
    "parameters",
    "sources",
    "dataset",
    "organizations"
  ],
  "properties": {
    "$schema": {
      "const": "urn:pfi-snt:synthetic-dataset-manifest:schema:2.0.0"
    },
    "schemaVersion": {
      "const": "2.0.0"
    },
    "generator": {
      "$ref": "#/$defs/generator"
    },
    "seed": {
      "const": 20260727
    },
    "parameters": {
      "$ref": "#/$defs/parameters"
    },
    "sources": {
      "$ref": "#/$defs/sources"
    },
    "dataset": {
      "$ref": "#/$defs/dataset"
    },
    "organizations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/organization"
      }
    }
  },
  "$defs": {
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "const": "cli-3-dataset-generator"
        },
        "version": {
          "const": "2.0.0"
        }
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["units"],
      "properties": {
        "units": {
          "type": "integer",
          "minimum": 50000
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transferRulesetId",
        "transferMatrixSchemaVersion",
        "stateMachineVersion",
        "organizationsManifestSchemaVersion"
      ],
      "properties": {
        "transferRulesetId": {
          "type": "string",
          "minLength": 1
        },
        "transferMatrixSchemaVersion": {
          "type": "string",
          "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$"
        },
        "stateMachineVersion": {
          "type": "string",
          "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$"
        },
        "organizationsManifestSchemaVersion": {
          "type": "string",
          "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$"
        }
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "hashFile",
        "sha256",
        "units",
        "happyPathUnits",
        "rejectionUnits",
        "unauthorizedTransferCases",
        "duplicateIdentityCases",
        "blockingStateCases",
        "explicitProhibitionCases",
        "defaultDenyCases"
      ],
      "properties": {
        "file": {
          "const": "dataset.json"
        },
        "hashFile": {
          "const": "dataset.sha256"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "units": {
          "type": "integer",
          "minimum": 50000
        },
        "happyPathUnits": {
          "type": "integer",
          "minimum": 1
        },
        "rejectionUnits": {
          "type": "integer",
          "minimum": 3
        },
        "unauthorizedTransferCases": {
          "type": "integer",
          "minimum": 2
        },
        "duplicateIdentityCases": {
          "type": "integer",
          "minimum": 1
        },
        "blockingStateCases": {
          "type": "integer",
          "minimum": 1
        },
        "explicitProhibitionCases": {
          "type": "integer",
          "minimum": 1
        },
        "defaultDenyCases": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "organization": {
      "oneOf": [
        {
          "$ref": "#/$defs/custodialOrganization"
        },
        {
          "$ref": "#/$defs/regulatorOrganization"
        }
      ]
    },
    "custodialOrganization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mspId", "canonicalId", "agentType", "clientRole"],
      "properties": {
        "mspId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9.-]+MSP$"
        },
        "canonicalId": {
          "type": "string",
          "pattern": "^(GLN|CUFE):[0-9]{13}$"
        },
        "agentType": {
          "enum": [
            "LABORATORY",
            "DRUGSTORE",
            "DISTRIBUTOR",
            "LOGISTICS_OPERATOR",
            "PHARMACY",
            "HEALTHCARE_FACILITY"
          ]
        },
        "clientRole": {
          "const": "operator"
        }
      }
    },
    "regulatorOrganization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mspId", "canonicalId", "agentType", "clientRole"],
      "properties": {
        "mspId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9.-]+MSP$"
        },
        "canonicalId": {
          "type": "string",
          "pattern": "^REG:[A-Z0-9.-]+$"
        },
        "agentType": {
          "const": "REGULATOR"
        },
        "clientRole": {
          "const": "regulatory-admin"
        }
      }
    }
  }
}
